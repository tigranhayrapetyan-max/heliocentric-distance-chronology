{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hdc/config.schema.json",
  "title": "HDC analysis configuration",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_type",
    "interval",
    "output_namespace"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "analysis_type": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "interval": {
      "type": "object",
      "required": [
        "start_astronomical_date",
        "stop_date"
      ]
    },
    "bodies": {
      "type": "object"
    },
    "conditions": {
      "type": "object"
    },
    "numerics": {
      "type": "object"
    },
    "output_namespace": {
      "type": "string"
    }
  }
}